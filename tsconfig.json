{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "noLib": true,
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "paths": { "bwmusic": ["./apps/bwmusic/lib.js"] }
  },
  "include": ["types/**/*.d.ts", "apps/**/*.js"]
}
